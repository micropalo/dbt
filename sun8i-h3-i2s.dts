/dts-v1/;
/plugin/;

/ {
    compatible = "allwinner,sun8i-h3";

    fragment@0 {
        target = <&i2s0>;
        __overlay__ {
            status = "okay";
            pinctrl-0 = <&i2s0_pins>;
            pinctrl-names = "default";
            #sound-dai-cells = <0>;
        };
    };

    fragment@1 {
        target-path = "/";
        __overlay__ {
            /* Define the Speaker Codec */
            spk_out: spk-out {
                #sound-dai-cells = <0>;
                compatible = "linux,spdif-dit";
                status = "okay";
            };

            /* Define the Mic Codec */
            mic_in: mic-in {
                #sound-dai-cells = <0>;
                compatible = "linux,spdif-dir";
                status = "okay";
            };

            sound_i2s {
                compatible = "simple-audio-card";
                simple-audio-card,name = "I2S-FullDuplex";
                simple-audio-card,format = "i2s";

                /* CPU acts as Clock Master for both */
                simple-audio-card,bitclock-master = <&dailink0_cpu>;
                simple-audio-card,frame-master = <&dailink0_cpu>;

                dailink0_cpu: simple-audio-card,cpu {
                    sound-dai = <&i2s0>;
                };

                /* This links BOTH codecs to the same bus */
                simple-audio-card,codec {
                    sound-dai = <&spk_out>;
                    /* Note: If your kernel is older, you might need 
                       separate dailinks for playback and capture */
                };
            };
        };
    };
};
