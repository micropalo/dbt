/dts-v1/;
/plugin/;

/ {
    compatible = "allwinner,sun8i-h3";

    fragment@0 {
        target = <&i2s0>;
        __overlay__ {
            status = "okay";
            pinctrl-0 = <&i2s0_pins>;
            pinctrl-names = "default";
        };
    };

    /* Optional: If using a simple DAC like PCM5102a (which needs no I2C) */
    fragment@1 {
        target-path = "/";
        __overlay__ {
            pcm5102a: pcm5102a {
                #sound-dai-cells = <0>;
                compatible = "ti,pcm5102a";
                status = "okay";
            };

            sound_i2s {
                compatible = "simple-audio-card";
                simple-audio-card,name = "I2S-DAC";
                simple-audio-card,format = "i2s";
                simple-audio-card,mclk-fs = <256>;
                
                simple-audio-card,cpu {
                    sound-dai = <&i2s0>;
                };

                simple-audio-card,codec {
                    sound-dai = <&pcm5102a>;
                };
            };
        };
    };
};
